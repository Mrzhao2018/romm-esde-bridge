[Unit]
Description=Refresh RomM metadata export for the ES-DE on-demand bridge
After=network-online.target docker.service
Wants=network-online.target
RequiresMountsFor=/var/lib/romm-esde-bridge

[Service]
Type=oneshot
User=romm-esde-bridge
Group=romm-esde-bridge
EnvironmentFile=/etc/romm-esde-bridge/bridge.env
ExecStart=/usr/bin/python3 /opt/romm-esde-bridge/bridge.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/opt/romm-esde-bridge /etc/romm-esde-bridge
ReadOnlyPaths=-/srv/romm
ReadWritePaths=/var/lib/romm-esde-bridge

[Install]
WantedBy=multi-user.target
