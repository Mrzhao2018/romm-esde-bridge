ROMM_API_URL=http://romm-server.local:8080
ROMM_PUBLIC_URL=http://romm-server.local:8080
BRIDGE_SEED_MANIFESTS=
ROMM_TOKEN_FILE=/etc/romm-esde-bridge/server-token
BRIDGE_OUTPUT_DIR=/var/lib/romm-esde-bridge
ROMM_HOST_ROOT=/srv/romm
BRIDGE_PLATFORMS=
BRIDGE_BIND=0.0.0.0
BRIDGE_PORT=8090
BRIDGE_PUBLIC_URL=http://romm-server.local:8090
# Optional browser screenshot translation. The default style is an OpenAI-compatible
# multimodal endpoint; use "gemini" for a native Gemini generateContent proxy.
# BRIDGE_TRANSLATION_BASE_URL=https://vision-proxy.example/v1
# BRIDGE_TRANSLATION_API_KEY_FILE=/etc/romm-esde-bridge/translation-api-key
# BRIDGE_TRANSLATION_MODEL=gemini-3-flash
# BRIDGE_TRANSLATION_API_STYLE=openai
# BRIDGE_TRANSLATION_TIMEOUT=30
# Optional: only needed when publishing the Windows OpenSSH helper.
# BOOTSTRAP_SSH_PUBLIC_KEY_FILE=/etc/romm-esde-bridge/installer-authorized-key.pub
