[Unit]
Description=Serve the RomM ES-DE bridge catalogue
After=network-online.target romm-esde-bridge-refresh.service
Wants=network-online.target
RequiresMountsFor=/var/lib/romm-esde-bridge

[Service]
Type=simple
User=romm-esde-bridge
Group=romm-esde-bridge
EnvironmentFile=/etc/romm-esde-bridge/bridge.env
ExecStart=/usr/bin/python3 /opt/romm-esde-bridge/serve.py
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/opt/romm-esde-bridge /etc/romm-esde-bridge /var/lib/romm-esde-bridge

[Install]
WantedBy=multi-user.target
